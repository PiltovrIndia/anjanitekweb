// Merge this match block into the deployed Firebase Storage policy.
// It assumes the application already establishes Firebase Authentication.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /feed/{draftId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|video/mp4|application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation)|application/vnd\\.(ms-excel|ms-powerpoint)');
      allow delete: if request.auth != null;
    }
  }
}
